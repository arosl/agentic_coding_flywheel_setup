[Unit]
Description=ACFS: retire herdr agents that are idle with no work left

# Nothing installs this unit: running reap unattended is a host unit change,
# the operator's call ('acfs agents reap --help'). Copy it and its timer to
# ~/.config/systemd/user/, then 'systemctl --user enable --now
# acfs-agents-reap.timer'. reap retires only in the project it runs in, so
# a drop-in names that project:
#   [Service]
#   WorkingDirectory=<the project's checkout>
# It runs the installed acfs, never a working tree, where other agents'
# uncommitted edits would run unattended. The installed acfs must be one
# that has this reap (acfs-update).

[Service]
Type=oneshot
# The user manager's PATH has none of the user's tool directories; reap
# needs herdr, am, br, bv and jq.
Environment=PATH=%h/.acfs/bin:%h/.local/bin:%h/.bun/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.acfs/bin/acfs agents reap
TimeoutStartSec=600
